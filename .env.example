# ─────────────────────────────────────────────────────────────────────────────
# ARGO — Environment Variable Reference
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to source control.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-python-secrets-token-hex-32-output

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///./argo_dev.db
# PostgreSQL + pgvector for production (use Compose or RDS):
# DATABASE_URL=postgresql+asyncpg://argo:password@localhost:5432/argo

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Microsoft Azure AD (MSAL OAuth2 — M365 login + Graph API) ─────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Team identifiers ──────────────────────────────────────────────────────────
# Primary contact whose mailbox ARGO monitors for overnight briefings
CEO_EMAIL=pm@yourfund.com
# WhatsApp recipient for morning briefing delivery (E.164 format)
PM_WHATSAPP_NUMBER=+971500000000

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Serper (financial news search) ───────────────────────────────────────────
SERPER_API_KEY=your-serper-api-key

# ── OpenAI (Whisper transcription + text embeddings for Research Lake) ────────
OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # default

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP=true
ENABLE_EMAIL_FETCH=true
ENABLE_OVERNIGHT_CRON=true

# WhatsApp bridge (Section 5 Option B)
WHATSAPP_BRIDGE_SECRET=replace-with-random-shared-secret
WHATSAPP_BRIDGE_URL=http://localhost:3001
BRIDGE_ALLOWED_GROUP_IDS=
BRIDGE_ALLOWED_GROUP_NAMES=ARP Trading

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AWS (required for production ECS deploy — not needed locally) ─────────────
# AWS_REGION=eu-west-1
# ECR_REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com
# ECR_REPOSITORY=argo
